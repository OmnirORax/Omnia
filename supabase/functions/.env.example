# Server-only settings. Copy to .env.local (ignored) for local functions serve.
# Hosted functions need an explicit list of trusted frontend origins.
OMNIA_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Paid scene generation is disabled until explicitly configured on the server.
# OPENAI_API_KEY=
# OMNIA_SCENE_GENERATION_ENABLED=true
# OMNIA_SCENE_MODEL=chatgpt-image-latest
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are platform-injected.
# Never copy elevated keys into a VITE_ variable or the frontend bundle.
