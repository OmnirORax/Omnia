{
  "name": "vite-min-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/model.test.mjs tests/structural.test.mjs tests/layout3d.test.mjs tests/presentation.test.mjs",
    "test:browser": "node tests/workbench.browser.mjs",
    "test:3d": "node tests/workspace3d.browser.mjs && node tests/textWorkspace.browser.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright-core": "1.61.1",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "packageManager": "yarn@4.18.1"
